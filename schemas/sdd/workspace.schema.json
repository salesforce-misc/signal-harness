{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signal-engineering-harness:schema:workspace:v1alpha1",
  "title": "Signal Engineering Harness Multi-Repository Workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "feature", "sponsor", "repositories"],
  "properties": {
    "apiVersion": { "const": "signal-harness/v1alpha1" },
    "kind": { "const": "Workspace" },
    "feature": { "type": "string", "minLength": 1 },
    "sponsor": { "type": "string", "minLength": 1 },
    "workflow": { "type": "string", "minLength": 1 },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": { "$ref": "#/$defs/stringList" },
        "exclude": { "$ref": "#/$defs/stringList" }
      }
    },
    "repositories": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["remote"],
        "properties": {
          "remote": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["read-write", "read-only"] },
          "author": { "type": "boolean", "default": false },
          "featureManifest": { "type": "string", "minLength": 1 },
          "profile": { "type": "string", "minLength": 1 },
          "interactsWith": { "$ref": "#/$defs/stringList" }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repo"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "repo": { "type": "string", "minLength": 1 },
          "dependsOn": { "$ref": "#/$defs/stringList" },
          "description": { "type": "string" },
          "source": { "type": "string", "minLength": 1 },
          "declaredStatus": { "type": "string", "minLength": 1 },
          "requiredChecks": { "$ref": "#/$defs/stringList" },
          "surfaces": { "$ref": "#/$defs/stringList" },
          "callers": { "$ref": "#/$defs/stringList" },
          "produces": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "kind": { "type": "string", "minLength": 1 }
              }
            }
          },
          "consumes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fromTask", "artifact"],
              "properties": {
                "fromTask": { "type": "string", "minLength": 1 },
                "artifact": { "type": "string", "minLength": 1 }
              }
            }
          },
          "ownership": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason", "evidence"],
            "properties": {
              "reason": { "type": "string", "minLength": 1 },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["repo", "path"],
                  "properties": {
                    "repo": { "type": "string", "minLength": 1 },
                    "path": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          },
          "base": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind"],
                "properties": {
                  "kind": { "const": "repository-default" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "task"],
                "properties": {
                  "kind": { "const": "dependency-head" },
                  "task": { "type": "string", "minLength": 1 }
                }
              }
            ]
          },
          "context": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repo", "path"],
              "properties": {
                "repo": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 }
              }
            }
          },
          "testCases": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "requirement"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "kind": { "enum": ["delta", "guard"] },
                "requirement": { "type": "string", "minLength": 1 },
                "traces": { "$ref": "#/$defs/stringList" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
