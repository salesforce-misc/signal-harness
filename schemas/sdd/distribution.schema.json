{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signal-engineering-harness:schema:distribution:v1alpha1",
  "title": "Signal Engineering Harness Distribution",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "signal-harness.io/v1alpha1" },
    "kind": { "const": "Distribution" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiresCore", "profileApi", "policy"],
      "properties": {
        "requiresCore": { "type": "string", "minLength": 1 },
        "profileApi": { "const": "signal-harness/v1alpha1" },
        "policy": { "type": "string", "minLength": 1 },
        "providers": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "policyModes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "default"],
          "properties": {
            "allowed": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["evaluation", "production"] }
            },
            "default": { "enum": ["evaluation", "production"] }
          }
        }
      }
    }
  }
}
